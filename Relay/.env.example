# Copy to .env beside compose.yml. Every line is optional.

# The domain or IP clients connect to. Empty: the relay asks Cloudflare
# (https://1.1.1.1/cdn-cgi/trace) and Google's DNS for this server's public
# IP on every start. Setting it means neither is ever contacted.
RELAY_PUBLIC_HOST=

# The port clients connect to; it is also the port compose publishes.
RELAY_PUBLIC_PORT=46405

# The name iGhostVT shows for this relay.
RELAY_NAME=

# Data connections one address may open in any 10 seconds; 0 turns the
# limit off.
#RELAY_RATE_PER_IP=60

# Space the drop zone (`ighostvt-cli drop`) may use on this server, like 4G
# or 500M, and the most one file may take after compression. 0 turns the
# drop zone off. Files there are not encrypted; see the README.
#RELAY_DROP_BYTES=4G
#RELAY_DROP_FILE_BYTES=4G
